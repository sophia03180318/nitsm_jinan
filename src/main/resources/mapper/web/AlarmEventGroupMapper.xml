<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jcca.web.event.dao.AlarmEventGroupMapper">

    <!-- 根据告警编码查询阶段配置 -->
    <select id="selectStageConfigByAlarmCode" parameterType="java.lang.String"
            resultType="java.lang.String">
        select e.stage_config
        from alarm_event_group e
                 join alarm_repository r
                      on e.event_type_ids = r.event_type_id
        where r.alarm_code = #{eventUniqueCode}
    </select>

</mapper>
