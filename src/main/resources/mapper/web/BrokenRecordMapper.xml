<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jcca.web.broken.dao.BrokenRecordMapper">

    <!-- 根据资产ID查询故障记录，按创建时间倒序 -->
    <select id="getListByAssetId" resultType="com.jcca.web.broken.entity.BrokenRecord">
        select *
        from BROKEN_RECORD
        where asset_id = #{assetId}
        order by CREATE_TIME desc
    </select>

</mapper>
