<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jcca.web.collect.dao.CollectDiskMapper">

    <!-- 查询指定资产最新的磁盘采集信息 -->
    <select id="selectRealTimeData" resultType="com.jcca.web.collect.entity.CollectDisk">
        SELECT *
        FROM COLLECT_DISK b
        WHERE b.COLLECT_CODE = (
            SELECT MAX(to_number(COLLECT_CODE)) AS code
            FROM COLLECT_DISK
            WHERE ASSET_ID = #{assetId}
        )
    </select>

</mapper>
