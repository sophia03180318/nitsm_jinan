<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jcca.web.nodes.dao.CenterNodesMapper">

    <!-- 根据IP查询节点 -->
    <select id="selectNodes" parameterType="string" resultType="com.jcca.web.nodes.entity.CenterNodes">
        select *
        from center_nodes e
        where (e.NODE_IP1 = #{nodeIp} or e.NODE_IP2 = #{nodeIp})
    </select>

</mapper>
