<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jcca.web.asset.dao.PromptInfoMapper">

    <select id="getPromptByDictName" parameterType="java.lang.String" resultType="java.lang.String">
        select VALUE
        from PROMPT_INFO
        where DICT_NAME = #{dictName}
          and DICT_KEY = #{type}
    </select>

    <select id="getExistPrompt" parameterType="string" resultType="string">
        select VALUE
        from PROMPT_INFO
        where SOFTWARETYPE_ID = #{key}
    </select>
</mapper>