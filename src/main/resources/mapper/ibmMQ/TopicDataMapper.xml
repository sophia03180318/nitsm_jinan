<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jcca.web.ibmMQ.dao.TopicDataMapper">

    <resultMap id="BaseResultMap" type="com.jcca.web.ibmMQ.entity.IBMTopicData">
        <id column="ID" property="id" jdbcType="VARCHAR"/>
        <result column="CAPTURETIME" property="capturetime" jdbcType="TIMESTAMP"/>
        <result column="HEALTHSTATE" property="healthstate" jdbcType="VARCHAR"/>
        <result column="PUBLISHEDMESSAGESCOUNT" property="publishedmessagescount" jdbcType="BIGINT"/>
        <result column="PUBLISHERSCOUNT" property="publisherscount" jdbcType="BIGINT"/>
        <result column="SUBSCRIBERSCOUNT" property="subscriberscount" jdbcType="BIGINT"/>
        <result column="MONITOR_ID" property="monitorId" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID,CAPTURETIME,HEALTHSTATE,PUBLISHEDMESSAGESCOUNT,PUBLISHERSCOUNT,SUBSCRIBERSCOUNT,MONITOR_ID
    </sql>

    <!-- 删除指定时间点的统计数据 -->
    <delete id="removeExpiredStatistics">
        delete from IBMMQ_TOPIC_DATA
        where monitor_id = #{monitorId}
          and captureTime = #{captureTime}
    </delete>

    <!-- 查询最新一条记录 -->
    <select id="queryLastDate" resultType="com.jcca.web.ibmMQ.entity.IBMTopicData">
        select *
        from (
                 select *
                 from IBMMQ_TOPIC_DATA
                 where monitor_id = #{monitorId}
                 order by captureTime desc
             ) t
        where rownum = 1
    </select>

    <!-- 查询最近 50 条记录 -->
    <select id="queryDetailData" resultType="com.jcca.web.ibmMQ.entity.IBMTopicData">
        select *
        from (
                 select *
                 from IBMMQ_TOPIC_DATA
                 where monitor_id = #{monitorId}
                 order by captureTime desc
             ) t
        where rownum &lt;= 50
    </select>

    <!-- 删除所有统计数据 -->
    <delete id="removeStatistics">
        delete from IBMMQ_TOPIC_DATA
        where monitor_id = #{monitorId}
    </delete>

</mapper>