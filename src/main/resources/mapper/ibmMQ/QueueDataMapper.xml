<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jcca.web.ibmMQ.dao.QueueDataMapper">

    <resultMap id="BaseResultMap" type="com.jcca.web.ibmMQ.entity.IBMQueueData">
        <id column="ID" property="id" jdbcType="VARCHAR"/>
        <result column="CAPTURETIME" property="capturetime" jdbcType="TIMESTAMP"/>
        <result column="HEALTHSTATE" property="healthstate" jdbcType="VARCHAR"/>
        <result column="CURRENTQDEPTH" property="currentqdepth" jdbcType="BIGINT"/>
        <result column="MAXQDEPTH" property="maxqdepth" jdbcType="BIGINT"/>
        <result column="OPENINPUTCOUNT" property="openinputcount" jdbcType="BIGINT"/>
        <result column="OPENOUTPUTCOUNT" property="openoutputcount" jdbcType="BIGINT"/>
        <result column="MONITOR_ID" property="monitorId" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID,CAPTURETIME,HEALTHSTATE,CURRENTQDEPTH,MAXQDEPTH,OPENINPUTCOUNT,OPENOUTPUTCOUNT,MONITOR_ID
    </sql>


    <!-- 删除过期统计数据 -->
    <delete id="removeExpiredStatistics">
        delete from IBMMQ_QUEUE_DATA
        where monitor_id = #{monitorId}
          and captureTime &lt; #{captureTime}
    </delete>

    <!-- 查询最新一条数据 -->
    <select id="queryLastDate" resultType="com.jcca.web.ibmMQ.entity.IBMQueueData">
        select *
        from (
                 select *
                 from IBMMQ_QUEUE_DATA
                 where monitor_id = #{monitorId}
                 order by captureTime desc
             )
        where rownum = 1
    </select>

    <!-- 查询最近 50 条数据 -->
    <select id="queryDetailData" resultType="com.jcca.web.ibmMQ.entity.IBMQueueData">
        select *
        from (
                 select *
                 from IBMMQ_QUEUE_DATA
                 where monitor_id = #{monitorId}
                 order by captureTime desc
             )
        where rownum &lt;= 50
    </select>

    <!-- 删除某监控下的所有数据 -->
    <delete id="removeStatistics">
        delete from IBMMQ_QUEUE_DATA
        where monitor_id = #{monitorId}
    </delete>

</mapper>