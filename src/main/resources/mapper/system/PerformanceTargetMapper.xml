<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jcca.admin.system.dao.PerformanceTargetMapper">

    <!-- 更新 PING_TUNNEL -->
    <update id="setPING">
        UPDATE PERFORMANCE_TARGET
        SET PING_TUNNEL = #{value}
        WHERE ID = #{id}
    </update>

</mapper>
